VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
# Backend Express server URL (no trailing slash)
# Local: http://localhost:3000  |  Render: https://vinovault.onrender.com
VITE_SERVER_URL=https://vinovault.onrender.com
# The following are injected by Vercel CLI / used by Vercel serverless functions
CLERK_SECRET_KEY=sk_test_...
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vinovault?retryWrites=true&w=majority&appName=Cluster0
VERCEL_OIDC_TOKEN=